@phdthesis{gidden_agent-based_2015,
	address = {Madison, WI, United States},
	type = {{PhD} {Thesis}},
	title = {An {Agent}-{Based} {Modeling} {Framework} and {Application} for the {Generic} {Nuclear} {Fuel} {Cycle}},
	abstract = {Key components of a novel methodology and implementation of an agent-based, dynamic nuclear fuel cycle simulator, Cyclus , are presented. The nuclear fuel cycle is a complex, physics-dependent supply chain. To date, existing dynamic simulators have not treated constrained fuel supply, time-dependent, isotopic-quality based demand, or fuel fungibility particularly well. Utilizing an agent-based methodology that incorporates sophisticated graph theory and operations research techniques can overcome these deficiencies. This work describes a simulation kernel and agents that interact with it, highlighting the Dynamic Resource Exchange (DRE), the supply-demand framework at the heart of the kernel. The key agent-DRE interaction mechanisms are described, which enable complex entity interaction through the use of physics and socio-economic models. The translation of an exchange instance to a variant of the Multicommodity Transportation Problem, which can be solved feasibly or optimally, follows. An extensive investigation of solution performance and fidelity is then presented. Finally, recommendations for future users of Cyclus and the DRE are provided.},
	school = {University of Wisconsin},
	author = {Gidden, Matthew J.},
	month = mar,
	year = {2015},
	file = {gidden_agent-based_2015.pdf:/Users/summer/Zotero/storage/TLJXGN7U/gidden_agent-based_2015.pdf:application/pdf;Snapshot:/Users/summer/Zotero/storage/ZTWMYGIL/1.html:text/html},
}

@phdthesis{nyberg_development_2025,
	address = {United States -- Wisconsin},
	type = {Ph.{D}.},
	title = {Development of a {Chloride} {Salt} {Fission}-{Fusion} {Hybrid} {System} for the {Transmutation} of {Minor} {Actinide} {Waste}},
	copyright = {Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
	isbn = {9798265446954},
	url = {https://www.proquest.com/pqdtglobal/docview/3276782923/abstract/D71F2BF2B2C14EEEPQ/1},
	abstract = {Minor Actinides (MAs) complicate repository design and are difficult to transmute in traditional reactors, but may be burned efficiently and safely using subcritical Externally Driven Systems (EDSs). Four primary categories were targets of analysis to further the understanding of EDS and create a feasible design to effectively burn long-lived nuclear waste from fission Used Nuclear Fuel (UNF):
• Down-selection of potential design characteristics alongside scoping and neutronics feasibility studies.
• Improvements to subcritical neutronics methodologies and applications to the optimization of subcritical systems.
• Workflows enabling accurate and efficient multiphysics analysis of EDSs and application to both critical and subcritical MA-burners, comparing safety over a wide array of accident scenarios.
• An expansion of economics methods to enable cost-benefit analyses of the down-selected fusion driven MA-burning EDS, and an application of these methods to assess its economics feasibility.
A novel molten chloride MA-fueled subcritical MA burner driven by a fusion neutron source (a Fission-Fusion Hybrid (FFH)) is presented that demonstrates neutronic viability, potential positive impacts on repository loading, safety benefits over an MA-fueled critical system, and potential for economic viability through value stacking of multiple revenue streams.
Subcritical system power is limited by the source strength, operating fission multiplication (kef f ), and the efficient utilization of source neutrons. Viable driving neutron sources are feasible in the near-term, and fusion neutron sources down-selected due to recent technological improvements, modern projects, and the ability to scale to moderate production rates on the order of 1017-1018 n s in the near future. Molten salts provide significant advantages over other coolants from the potential for extremely high burnups and integration with existing fuel processing technologies. Chloride salts were chosen due to neutron energy spectra requirements for effective MA burning. Two primary compositions were chosen for further analysis: a UNF-derived MA composition from traditional Uranium-Oxide (UOX) fuel in Light Water Reactors (LWRs) and another modeling MA from Mixed-Oxide (MOX)-fueled LWRs. This system presents advantages over previous designs in literature, and demonstrates the potential to significantly improve the efficiency of repositories through safe and effective burning of MAs.
Subcritical system power is limited by the source strength, operating kef f , and the efficient utilization of source neutrons. A novel definition for source utilization η is introduced as an effective predictor of power over a wide range of kef f which enables a significant reduction in sensitivity to uncertainty in initial eigenvalue calculations and 2-3 orders of magnitude xv faster statistical convergence in fixed source calculations at kef f = 0.98. This facilitates efficient analysis and optimization of subcritical power in Monte Carlo based neutronics codes. Initial characteristics of the annular subcritical system are explored in OpenMC, and parametric studies evaluating η are performed leading to general geometric and material power scalings for subcritical systems. Through maximizing η, models achieve subcritical powers above 500 MWth and tritium production far above replacement with a compact mirror fusion device on the order of one megawatt with a source strength of 5 × 1017 n s and a significantly subcritical blanket (kef f = 0.98). These techniques are then applied to a parametric model of a scaled fusion mirror with geometries and sources accurate to the next generation of fusion mirror devices, and demonstrate powers of nearly 1500 MWth and tritium breeding ratios above 30.
Two challenges were identified in the multiphysics modeling of EDSs for Transuranic (TRU) burning with existing workflows: complex, spatially varying sources and flexible opensource production of cross-sections. A workflow is presented coupling the source and multigroup cross-section generation within OpenMC to the GeN-Foam multiphysics solver. First, OpenMC generated nuclear data was exported for transuranic-based molten salt reactor GeN-Foam model, and neutronics characteristics were verified against an equivalent OpenMC model. This TRU-based fueled salt was compared to uranium-thorium molten salt at steady state and over a range of potential accident scenarios. Secondly, a method utilizing the OpenMC C++ API sampled a fusion source onto a mesh used within GeN-Foam simulations, enabling closely coupled EDS multiphysics analysis. This spatially accurate source definition was verified against OpenMC models, and then was demonstrated for transient scenarios. This workflow enables closely coupled multiphysics analysis of complex critical or EDSs using open-source tools. This workflow is then applied to critical and subcritical versions of the MA-chloride FFH systems down-selected and optimized in neutronics analysis. While critical MA-chloride systems are stable to accident scenarios with long timescales, inherent reactor physics characteristics of the MA fuel greatly increase sensitivity to Unprotected Transient Over Power (UTOP) reactivity insertions. Subcritical systems operate far from criticality and are intrinsically stable to this type of accident scenario, presenting a motivation for subcritical operation.
The FFH device proposed presents several value streams beyond electricity generation, including the increase in efficiency of long-term nuclear waste repositories and production of substantial amounts of nuclear fusion fuel. A new method for the analysis of fusion fuel cycles was created based on the fission fuel cycle code Cyclus, and demonstrates a new ability to flexibly analyze complex fusion systems. Predictions for potential revenue from each source are made, and find that both MA burning and tritium production can provide revenue streams of the same magnitude as electricity production. Nuclear costing analysis is notoriously difficult, and FFH systems combine many of the complications of the established nuclear fission analysis with novel nuclear fusion costs. New fusion models are added to the fission capital costing code ACCERT, and similar methods are applied to the specific magnetic mirror system used as the driving neutron source for the FFH. The combined cost of the fission, fusion, and secondary systems for the FFH are estimated and the mirror-based systems analyzed in subcritical neutronics design are estimated to cost \$4.5 billion to build. A Net Present Value (NPV) study of the system using the predicted costs and revenues finds that the system may be economically feasible if revenues from MA burning can be realized.},
	language = {English},
	urldate = {2026-01-13},
	school = {The University of Wisconsin - Madison},
	author = {Nyberg, Matthew J.},
	year = {2025},
	keywords = {Nuclear engineering, Transmutation, Applied physics, Fission-Fusion Hybrid, Minor Actinides, Subcritical systems},
	file = {Full Text PDF:/Users/summer/Zotero/storage/K49JLAD3/Nyberg - 2025 - Development of a Chloride Salt Fission-Fusion Hybrid System for the Transmutation of Minor Actinide.pdf:application/pdf},
}

